# apps/web/.env.example — 복사해서 .env.local로 쓴다. 실제 값이 든 .env.local은 커밋 금지.
# 각 키의 발급처는 README "필요한 API 키와 발급처" 참고.

# --- 필수 ---
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키 (REST 키와 다른 값!)
# 콘솔의 플랫폼 > Web에 사이트 도메인(http://localhost:3000 등)을 등록해야 지도가 뜬다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# --- agent-api 주소 ---
# 브라우저에서 부르는 주소. 폰/다른 기기에서 열 거면 127.0.0.1이 아니라 LAN IP로.
NEXT_PUBLIC_AGENT_API_URL=http://127.0.0.1:8787
# Next.js 서버(라우트 핸들러)에서 부르는 주소. 같은 머신이면 127.0.0.1 그대로 둔다.
AGENT_API_URL=http://127.0.0.1:8787

# --- 선택 ---
# next dev를 LAN 주소로 열 때 허용할 오리진, 쉼표 구분. 그 기기의 IP를 넣는다.
NEXT_DEV_ORIGINS=

# 사내망 배포용 게이트. agent-api 쪽과 같은 값으로 맞춘다.
BASIC_AUTH_USER=daol
BASIC_AUTH_PASS=
