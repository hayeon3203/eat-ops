# apps/agent-api/.env.example — 복사해서 .env로 쓴다. 실제 값이 든 .env는 커밋 금지.
# 각 키의 발급처는 README "필요한 API 키와 발급처" 참고.

# --- 필수 ---
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# 없으면 장소 검색/등록/기록이 전부 실패한다.
KAKAO_REST_API_KEY=

# --- 선택: Foundry(클라우드) provider ---
# 비워두면 /foundry 라우트가 등록되지 않고 로컬 provider만 쓴다.
# 키가 아니라 엔드포인트 URL이다. 별도로 `az login` 세션이 필요하다.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL=gpt-5-mini-1

# --- 선택: 로컬 vLLM provider ---
LOCAL_VLLM_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_VLLM_MODEL=exaone-4.0-32b

# --- 선택: 도구 ---
# 직접 호스팅하는 SearXNG. 안 떠 있으면 web_search 도구만 실패한다.
SEARXNG_BASE_URL=http://127.0.0.1:8081

# --- 선택: 서버 ---
VISITS_DB_PATH=apps/agent-api/data/visits.db
HOST=127.0.0.1
PORT=8787

# --- 선택: 사내망 배포용 게이트 ---
# 발급받는 값이 아니라 직접 정하는 값. BASIC_AUTH_PASS가 비면 게이트가 꺼진다.
# 인증 없이 LAN에 열지 말 것. apps/web 쪽과 같은 값으로 맞춘다.
BASIC_AUTH_USER=daol
BASIC_AUTH_PASS=
